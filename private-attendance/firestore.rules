rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function canAccessAttendance(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/attendanceAccess/$(uid));
    }

    match /users/{uid} {
      allow get, create, update: if canAccessAttendance(uid);

      match /{collection}/{record} {
        allow read, write: if collection in [
          'attendance', 'leaves', 'overtime', 'holidays', 'leaveBalances'
        ] && canAccessAttendance(uid);
      }
    }
  }
}
